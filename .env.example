#############################################
# ROOT .env — Docker Compose configuration
# Scope: infrastructure only (container names,
# ports, top-level orchestration values).
#
# This file is consumed by compose.yaml.
# It must NEVER contain application secrets
# (JWT keys, DB passwords used in production,
# API keys). Those belong in backend/.env,
# which is loaded separately via env_file.
#
# DO NOT COMMIT THIS FILE.
# Commit .env.example instead (same keys,
# placeholder values).
#############################################

# --------------------------------------------
# PostgreSQL
# --------------------------------------------
POSTGRES_CONTAINER_NAME=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --------------------------------------------
# Backend (Spring Boot)
# --------------------------------------------
BACKEND_CONTAINER_NAME=
BACKEND_PORT=

# --------------------------------------------
# Frontend (Angular)
# --------------------------------------------
FRONTEND_CONTAINER_NAME=
FRONTEND_PORT=