#############################################
# ROOT .env — Docker Compose configuration
# Scope: infrastructure only (container names,
# ports, top-level orchestration values).
#
# This file is consumed by compose.yaml.
# It must NEVER contain application secrets
# (JWT keys, DB passwords used in production,
# API keys). Those belong in backend/.env,
# which is loaded separately via env_file.
#
# DO NOT COMMIT THIS FILE.
# Commit .env.example instead (same keys,
# placeholder values).
#############################################

# --------------------------------------------
# PostgreSQL
# --------------------------------------------
POSTGRES_CONTAINER_NAME=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

#based on the provided prod config there is 2 different approaches to config mail sending through the user account or API
# PRODUCTION MAIL configuration variables
MAIL_HOST=smtp.sendgrid.net          # Or ://gmail.com, ://yourdomain.com, etc.
MAIL_SMTP_PORT=587                   # Standard production secure port (587 or 465)
MAIL_USERNAME=apikey                 # Your real production username
MAIL_PASSWORD=prod_secret_api_key

# --------------------------------------------
# Backend (Spring Boot)
# --------------------------------------------
BACKEND_CONTAINER_NAME=
BACKEND_PORT=

# --------------------------------------------
# Frontend (Angular)
# --------------------------------------------
FRONTEND_CONTAINER_NAME=
FRONTEND_PORT=