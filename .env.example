#############################################
# ROOT .env — Docker Compose configuration
# Scope: infrastructure only (container names,
# ports, top-level orchestration values).
#
# This file is consumed by compose.yaml.
# It must NEVER contain application secrets
# (JWT keys, DB passwords used in production,
# API keys). Those belong in backend/.env,
# which is loaded separately via env_file.
#
# DO NOT COMMIT THIS FILE.
# Commit .env.example instead (same keys,
# placeholder values).

# This file contains Docker Compose configuration
# and development-only infrastructure credentials.
#
# NEVER commit this file.
#
# Production secrets must be injected securely
# through the deployment environment / secret manager.
#############################################


# ============================================================
# APPLICATION
# ============================================================
APP_NAME=assofin
SPRING_PROFILES_ACTIVE=dev #changed based on the environement

# ============================================================
# JWT
# ============================================================

# Development secret only
# Production: use a strong secret from your CI/CD secret manager
JWT_SECRET_KEY=

# JWT expiration in milliseconds
# 15 minutes = 86400000 ms
JWT_EXPIRATION_MS=86400000

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_CONTAINER_NAME=assofin.postgres
POSTGRES_DB=assofin.db
POSTGRES_USER=assofin
POSTGRES_PASSWORD=change_me #forget to change the password of the db
# Spring Boot is running locally, PostgreSQL is running in Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# REDIS
# ============================================================

# Spring Boot is running locally, Redis is running in Docker
REDIS_CONTAINER_NAME = redis.assofin
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
#2000ms (2s)
REDIS_TIMEOUT_MS=2000

# ============================================================
# MAILDEV
# ============================================================

# MailDev Docker container ports
MAILDEV_CONTAINER_NAME=mail-dev.assofin
MAILDEV_HOST=localhost
MAILDEV_UI_PORT=1080
MAILDEV_SMTP_PORT=1025


# Spring Boot mail configuration
# Backend runs on the host, therefore it connects to localhost
MAIL_HOST=localhost
MAIL_PORT=1025

# MailDev does not require authentication
MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Sender address used by the application
MAIL_FROM=no-reply@assofin
# --------------------------------------------
# Backend (Spring Boot)
# --------------------------------------------
BACKEND_CONTAINER_NAME=assofin.backend
BACKEND_PORT=8080


# ============================================================
# FRONTEND (Angular)
# ============================================================
FRONTEND_CONTAINER_NAME=assofin.frontend
FRONTEND_PORT=4200

# Used when generating account activation links
FRONTEND_ACTIVATION_URL=http://localhost:4200/activate
