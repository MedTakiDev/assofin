# ============================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ============================================================
# Copy this file to .env at the repository root and fill it in:
#
#   cp .env.example .env
#
# Used by:
#   - docker compose (reads .env automatically)
#   - Spring Boot in the dev profile (see application-dev.yml)
#   - IntelliJ, if the run configuration uses it as an env file
#
# .env holds real local secrets and is ignored by git. Never
# commit it. This example file holds placeholders only.
#
# Production does not use this file: secrets are injected as
# real environment variables by the deployment platform.
#
# FORMAT RULES (several tools parse this file, differently):
#   - one KEY=value per line
#   - no spaces around =
#   - no quotes around values
#   - comments on their own line only, never after a value
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
APP_NAME=assofin
SPRING_PROFILES_ACTIVE=dev

# ============================================================
# JWT
# ============================================================
# Base64 key of at least 256 bits. Generate your own with:
#   openssl rand -base64 32
JWT_SECRET_KEY=

# Token lifetime in milliseconds. 86400000 ms = 24 hours.
JWT_EXPIRATION_MS=86400000

# ============================================================
# BOOTSTRAP ADMIN
# ============================================================
# Default administrator created on startup when no user holds
# the ADMIN role (first start on an empty database).
# Ignored once an admin exists: changing it later does NOT
# reset the admin password.
# CHANGE THE PASSWORD in every real environment (min 12 chars).
ADMIN_EMAIL=admin@assofin.local
ADMIN_PASSWORD=change_me_please_12+
ADMIN_FIRSTNAME=System
ADMIN_LASTNAME=Administrator

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_CONTAINER_NAME=assofin.postgres
POSTGRES_DB=assofin.db
POSTGRES_USER=assofin
# Change this before the first start.
POSTGRES_PASSWORD=change_me
# Spring Boot runs on the host, PostgreSQL runs in Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# MAILDEV
# ============================================================
# MailDev Docker container ports
MAILDEV_CONTAINER_NAME=mail-dev.assofin
MAILDEV_HOST=localhost
MAILDEV_UI_PORT=1080
MAILDEV_SMTP_PORT=1025

# Spring Boot mail configuration.
# The backend runs on the host, so it connects to localhost.
MAIL_HOST=localhost
MAIL_PORT=1025

# MailDev does not require authentication.
MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Sender address used by the application
MAIL_FROM=no-reply@assofin

# ============================================================
# BACKEND (Spring Boot)
# ============================================================
BACKEND_CONTAINER_NAME=assofin.backend
BACKEND_PORT=8080

# ============================================================
# FRONTEND (Angular)
# ============================================================
FRONTEND_CONTAINER_NAME=assofin.frontend
FRONTEND_PORT=4200
